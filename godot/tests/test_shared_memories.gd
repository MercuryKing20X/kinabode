extends SceneTree
const Places=preload("res://scripts/map_locations.gd")
const World=preload("res://scripts/world_state.gd")
const Save=preload("res://scripts/save_store.gd")
const Fixture=preload("res://tests/memory_fixture.gd")
var checks:=0
var failed:=false
func check(value: bool,label: String) -> void:
	checks+=1
	if not value:failed=true;push_error(label)
func _initialize() -> void:call_deferred("run")
func run() -> void:
	var directory:=OS.get_environment("HABITAT_DATA_DIR")
	if not directory.contains("youqi-test-"):quit(1);return
	var world:=World.new()
	check(world.read_memories("human").memories.is_empty(),"fresh world never invents past experiences")
	var populated: bool=Fixture.populate(world,directory)
	check(populated,"real work supplies all four memory categories")
	if not populated:quit(1);return
	var all: Dictionary=world.read_memories("human")
	check(all.ok and all.total==3,"default feed folds completed activity portions into one real activity")
	var kinds: Array=all.memories.map(func(entry):return entry.kind)
	check("shared_barbecue" in kinds and "sat_together" in kinds and "house_completed" in kinds,"unified feed includes actual dinner, sitting and construction")
	var meals:Dictionary=world.read_memories("human",{"kind":"shared_barbecue"})
	check(meals.total==1 and meals.memories[0].facts.foods.size()==3 and meals.memories[0].facts.foods.values().all(func(foods):return foods.size()==1),"explicit barbecue query preserves exactly three actual per-person food facts")
	check(meals.memories[0].participants.has("codex") and meals.memories[0].participants.has("companion-2"),"overlapping participant is not mislabeled as sole eater")
	check(world.read_memories("npc.mira").total==0,"nearby uninvited NPC does not acquire others' experiences")
	check(world.read_memories("companion-2",{"kind":"house_completed"}).total==0,"model gets no invented human or construction contribution")
	var house: Dictionary=world.read_memories("human",{"kind":"house_completed"}).memories[0]
	check(house.facts.contributions.human.wood>0 and house.facts.contributions.codex.stages>0,"completed house credits physical contributions")
	var detail: Dictionary=world.read_memories("human",{"memory_id":meals.memories[0].id})
	check(detail.ok and detail.total==1 and detail.memories[0].kind=="shared_barbecue","folded meal still has exact factual detail by stable id")
	check(not world.read_memories("npc.mira",{"memory_id":meals.memories[0].id}).ok,"exact lookup cannot read nonparticipant experience")
	var other:=World.new()
	check(not other.read_memories("human",{"memory_id":house.id}).ok,"memory ids are scoped to world")
	var stable: Dictionary=world.memories.saved();var revision: int=world.revision
	for i in range(4):world.read_memories("human",{"limit":1});world.observe("codex",{"limit":1})
	check(world.memories.saved()==stable and world.revision==revision,"reading never mutates journal, sources, jobs or revision")
	var page: Dictionary=world.read_memories("human",{"limit":1})
	check(page.next_offset==1 and page.total==3,"bounded page exposes total and continuation")
	world.command("human",{"intent":"move","x":Places.point("p_22_5_48_8").x,"y":Places.point("p_22_5_48_8").y});world.advance(.2)
	check(world.read_memories("human",{"offset":1,"limit":1,"revision":page.revision}).ok,"walking does not invalidate memory pagination")
	check(not world.read_memories("human",{"offset":1}).ok,"continuation requires memory revision")
	check(not world.read_memories("human",{"offset":1,"revision":page.revision,"kind":"meal"}).ok,"cursor cannot silently change filters")
	world.residents.rename(world,"codex","新名字")
	check(world.read_memories("human",{"memory_id":house.id}).memories[0].participant_names.codex=="新名字","rename preserves ids and uses current label")
	check(world.read_memories("human",{"offset":1,"revision":page.revision}).get("error")=="stale_memories","rename invalidates presentation pages without rewriting facts")
	world.command("human",{"intent":"stop"})
	for args in [{"actor_id":"codex"},{"kind":"wish"},{"limit":0},{"limit":51},{"offset":-1},{"offset":true},{"limit":1.5},{"after":NAN},{"before":INF},{"after":-1},{"after":5,"before":1},{"revision":123},{"memory_id":""},{"with_resident":"missing"}]:
		check(not world.read_memories("human",args).ok,"invalid memory query rejected "+str(args))
	var barbecue: Dictionary=world.read_memories("human",{"kind":"shared_barbecue"}).memories[0]
	check(world.read_memories("human",{"kind":"shared_barbecue","after":barbecue.occurred_at,"before":barbecue.occurred_at}).total==1,"time filter includes exact boundaries")
	check(world.read_memories("human",{"with_resident":"companion-2"}).total==1,"participant filter uses actual intersection")
	check(world.observe("codex").memories.self_actor_id=="codex","model snapshot contains bounded own memories without a new dynamic tool")
	check(Save.save_world(world,directory.path_join("saved")),"new journal saves in optional schema7 field")
	var serialized: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(directory.path_join("saved/island-v2.json")))
	check(world.memories.valid_saved(serialized.shared_memories,serialized.actors,serialized.world_id),"serialized journal validates after JSON numeric conversion")
	if not world.memories.valid_saved(serialized.shared_memories,serialized.actors,serialized.world_id):
		for entry in serialized.shared_memories.records:
			if not world.memories.valid_saved({"version":1,"records":[entry],"source_marks":[]},serialized.actors,serialized.world_id):print("Invalid memory entry: ",entry)
	var loaded:=World.new()
	check(Save.load_world(loaded,directory.path_join("saved")).ok,"new journal loads with source facts")
	check(JSON.parse_string(JSON.stringify(loaded.memories.saved()))==JSON.parse_string(JSON.stringify(world.memories.saved())),"load import is idempotent and keeps stable ids")
	loaded.memories.sync();loaded.memories.sync()
	check(JSON.parse_string(JSON.stringify(loaded.memories.saved()))==JSON.parse_string(JSON.stringify(world.memories.saved())),"repeated import does not duplicate experiences")
	var legacy: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(directory.path_join("saved/island-v2.json")))
	legacy.erase("shared_memories")
	for entry in legacy.shared_life.memories:entry.erase("event_id")
	for entry in legacy.interior.memories:entry.erase("event_id")
	var legacy_dir:=directory.path_join("legacy");DirAccess.make_dir_recursive_absolute(legacy_dir)
	var file:=FileAccess.open(legacy_dir.path_join("island-v2.json"),FileAccess.WRITE);file.store_string(JSON.stringify(legacy));file.close()
	var migrated:=World.new();check(Save.load_world(migrated,legacy_dir).ok,"legacy save imports only retained source events")
	var imported: Dictionary=migrated.memories.saved();migrated.memories.sync()
	check(migrated.read_memories("human").total==2 and migrated.memories.saved()==imported,"legacy import keeps two retained source events and never reconstructs a deleted barbecue replay stream")
	check(Save.save_world(migrated,legacy_dir),"legacy import can persist without resetting progress")
	var again:=World.new();check(Save.load_world(again,legacy_dir).ok and JSON.parse_string(JSON.stringify(again.memories.saved()))==JSON.parse_string(JSON.stringify(imported)),"legacy timestamp/key precision survives save round trip")
	var pressure:=World.new();check(Save.load_world(pressure,directory.path_join("saved")).ok,"load genuine event fixture for bounded retention")
	# Exercise the production eviction algorithm with a small test-only capacity.
	pressure.memories.capacity=pressure.memories.records.size()
	var bounded_capacity: int=pressure.memories.capacity
	var chair_ids: Array=pressure.interior.furniture.keys()
	check(Fixture.job(pressure,"human",{"intent":"sit","target_id":chair_ids[0]}),"real actor returns to crafted chair")
	check(Fixture.job(pressure,"codex",{"intent":"sit","target_id":chair_ids[1]}),"new actual shared sitting adds a new event")
	check(pressure.memories.records.size()==bounded_capacity and pressure.read_memories("human",{"memory_id":house.id}).get("error")=="memory_not_found","oldest journal fact is evicted only at configured capacity")
	check(pressure.projects.memories.size()==1,"evicted canonical fact still exists in old source collection")
	check(Save.save_world(pressure,directory.path_join("pressure")),"eviction marks persist with journal")
	var after_pressure:=World.new();check(Save.load_world(after_pressure,directory.path_join("pressure")).ok,"bounded journal reloads")
	check(after_pressure.memories.records.size()==bounded_capacity and after_pressure.read_memories("human",{"memory_id":house.id}).get("error")=="memory_not_found","loading never resurrects a marked evicted source event")
	var retained_meals: int=after_pressure.read_memories("human",{"kind":"shared_barbecue"}).total
	after_pressure.life.memories.clear();after_pressure.memories.sync()
	check(after_pressure.read_memories("human",{"kind":"shared_barbecue"}).total==retained_meals,"journal survives source history truncation")
	check(Save.save_world(after_pressure,directory.path_join("pruned")),"journal persists without original meal source")
	var pruned:=World.new();check(Save.load_world(pruned,directory.path_join("pruned")).ok and pruned.read_memories("human",{"kind":"shared_barbecue"}).total==retained_meals,"retained facts remain available after source pruning and reload")
	legacy.shared_memories=world.memories.saved();legacy.shared_memories.records[0].facts["invented_feeling"]="very happy"
	var invalid_dir:=directory.path_join("invalid");DirAccess.make_dir_recursive_absolute(invalid_dir)
	file=FileAccess.open(invalid_dir.path_join("island-v2.json"),FileAccess.WRITE);file.store_string(JSON.stringify(legacy));file.close()
	var invalid: Dictionary=Save.load_world(World.new(),invalid_dir)
	check(not invalid.ok and FileAccess.file_exists(invalid.get("backup","")),"invalid structured memory preserves recoverable save copy")
	print("Shared memories: %s checks, %s"%[checks,"FAIL" if failed else "PASS"])
	quit(1 if failed else 0)
