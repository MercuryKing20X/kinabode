extends "res://tests/test_standard_opening.gd"
func run()->void:
	var dir:String=OS.get_environment("HABITAT_DATA_DIR")
	var w:RefCounted=fresh(dir)
	check(Opening.apply(w,w.library,"standard").ok,"new standard")
	check(w.standard.goals.rows(w).size()==16,"DIRECTION: sixteen shared goals")
	for row in w.standard.goals.definitions:check(not row.zh.is_empty() and not row.en.is_empty(),"bilingual "+row.id)
	check(w.standard.goals.next(w).id=="wood","DIRECTION: wood first")
	check(not w.standard.goals.proof(w,"harvest"),"no invented harvest")
	check(not w.barbecues["home.barbecue"].fireside.host_ready("codex").ok,"ordinary local has no fire authority")
	check(B.wood(w,2,"human"),"real tree produces wood")
	w.standard.goals.observe(w)
	check(w.standard.board_completed.has("goal.wood"),"real stock marks ten wood")
	check(w.standard.valid(w.standard.saved()),"new optional goal keys validate")
	var before:Dictionary=w.storage.saved().duplicate(true)
	w.standard.goals.observe(w)
	check(w.storage.saved()==before,"observation never handles items")
	check(Save.save_world(w,dir.path_join("goals")),"save goal proofs")
	var loaded:RefCounted=fresh(dir.path_join("read"))
	check(Save.load_world(loaded,dir.path_join("goals")).ok,"reload extended goals")
	check(loaded.standard.board_completed.has("goal.wood"),"goal survives reload")
	print("TUTORIAL_GOALS ",checks," failed=",failed);quit(1 if failed else 0)
