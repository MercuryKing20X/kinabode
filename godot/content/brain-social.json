            {
              "actor": "npc.mira",
              "zh": "我可不想一会儿拍你背。",
              "en": "I do not fancy thumping your back."
            },
            {
              "actor": "npc.nora",
              "zh": "嗯，知道你关心。",
              "en": "Concern noted."
