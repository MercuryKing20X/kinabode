        {
          "id": "npc.mira_npc.nora_waiting",
          "context": "waiting",
          "lines": [
            {
              "actor": "npc.mira",
              "zh": "肚子都催了，岛主还磨蹭。",
              "en": "Stomach is complaining. Boss is dawdling."
            },
            {
              "actor": "npc.nora",
              "zh": "你催岛主，我等饭。",
              "en": "You nag. I wait."
