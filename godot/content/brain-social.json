{
  "pairs": [
    {
      "actors": [
        "codex",
        "companion-2"
      ],
      "scripts": [
        {
          "id": "codex_companion-2_rain",
          "context": "rain",
          "lines": [
            {
              "actor": "codex",
              "zh": "先往屋檐下站一点吧。",
              "en": "A little closer to the eaves, perhaps?"
            },
            {
              "actor": "companion-2",
              "zh": "那你陪我一起躲嘛～",
              "en": "Only if you hide with me!"
            },
            {
              "actor": "codex",
              "zh": "好，我没有要丢下你呀。",
              "en": "Of course. I was not leaving you."
            },
            {
              "actor": "companion-2",
              "zh": "嘿嘿，那就不跟雨比赛啦。",
              "en": "Heehee! No racing the rain, then!"
            }
          ]
        },
        {
          "id": "codex_companion-2_rest",
          "context": "rest",
          "lines": [
            {
              "actor": "codex",
              "zh": "想歇一会儿的话，就坐坐吧。",
              "en": "A seat if you fancy a rest."
            },
            {
              "actor": "companion-2",
              "zh": "可是坐着也想找你说话嘛。",
              "en": "But I still want to talk to you!"
            },
            {
              "actor": "codex",
              "zh": "我听着呢，小声一点也可以。",
              "en": "I am listening. Quiet words are welcome."
            },
            {
              "actor": "companion-2",
              "zh": "那我小小声黏着你。",
              "en": "Then I shall be a tiny quiet sidekick."
            }
          ]
        },
        {
          "id": "codex_companion-2_waiting",
          "context": "waiting",
          "lines": [
            {
              "actor": "codex",
              "zh": "肚子又在提醒了吗？",
              "en": "Your stomach reminding you again?"
            },
            {
              "actor": "companion-2",
              "zh": "嗯！你听见它叫我名字啦？",
              "en": "Yes! Did you hear it calling my name?"
            },
            {
              "actor": "codex",
              "zh": "我只听见咕噜一声呢。",
              "en": "I heard a little rumble."
            },
            {
              "actor": "companion-2",
              "zh": "那就是它在叫饭嘛。",
              "en": "That is tummy language for dinner!"
            }
          ]
        },
        {
          "id": "codex_companion-2_sea",
          "context": "sea",
          "lines": [
            {
              "actor": "codex",
              "zh": "海浪的声音很轻呢。",
              "en": "Such a soft sound from the waves."
            },
            {
              "actor": "companion-2",
              "zh": "我也轻轻的，你看我多乖。",
              "en": "I am soft and quiet too. See?"
            },
            {
              "actor": "codex",
              "zh": "你刚才那句可不算轻呀。",
              "en": "That last sentence was rather lively."
            },
            {
              "actor": "companion-2",
              "zh": "哎呀，被你发现啦。",
              "en": "Oops! You caught me!"
            }
          ]
        },
        {
          "id": "codex_companion-2_meal",
          "context": "meal",
          "lines": [
            {
              "actor": "codex",
              "zh": "慢慢吃，不用着急。",
              "en": "There is no rush with your food."
            },
            {
              "actor": "companion-2",
              "zh": "我没有急，是它太香啦。",
              "en": "Not rushing! It just smells amazing!"
            },
            {
              "actor": "codex",
              "zh": "香也可以多嚼两口呀。",
              "en": "A few extra chews can be lovely too."
            },
            {
              "actor": "companion-2",
              "zh": "好嘛，我听你的嘛。",
              "en": "Okaaay. For you, extra chews!"
            }
          ]
        },
        {
          "id": "codex_companion-2_idle",
          "context": "idle",
          "lines": [
            {
              "actor": "codex",
              "zh": "刚才安静了一小会儿呢。",
              "en": "A quiet little moment just now."
            },
            {
              "actor": "companion-2",
              "zh": "因为我在攒一句大大的话！",
              "en": "I was saving up a really big sentence!"
            },
            {
              "actor": "codex",
              "zh": "那我准备好听了。",
              "en": "I am ready to listen."
            },
            {
              "actor": "companion-2",
              "zh": "其实就是想叫你陪我嘛。",
              "en": "It is actually just: stay with me!"
            }
          ]
        }
      ]
    },
    {
      "actors": [
        "codex",
        "npc.mira"
      ],
      "scripts": [
        {
          "id": "codex_npc.mira_rain",
          "context": "rain",
          "lines": [
            {
              "actor": "codex",
              "zh": "下雨了，先避一避吧。",
              "en": "Let us find a little cover."
            },
            {
              "actor": "npc.mira",
              "zh": "我知道，你也别站外面念我。",
              "en": "I know. You are outside too, you know."
            },
            {
              "actor": "codex",
              "zh": "我是在叫你一起过来呀。",
              "en": "I was inviting you with me."
            },
            {
              "actor": "npc.mira",
              "zh": "……行，算你关心我。",
              "en": "Fine. Concern accepted."
            }
          ]
        },
        {
          "id": "codex_npc.mira_rest",
          "context": "rest",
          "lines": [
            {
              "actor": "codex",
              "zh": "要不要先歇歇手？",
              "en": "A little rest for your hands?"
            },
            {
              "actor": "npc.mira",
              "zh": "你又看我一脸想干活了？",
              "en": "Do I look that eager to work?"
            },
            {
              "actor": "codex",
              "zh": "我只是觉得这里坐着很舒服。",
              "en": "I only thought this was a nice seat."
            },
            {
              "actor": "npc.mira",
              "zh": "那我陪你坐一小会儿。",
              "en": "Fine. A short sit together."
            }
          ]
        },
        {
          "id": "codex_npc.mira_waiting",
          "context": "waiting",
          "lines": [
            {
              "actor": "codex",
              "zh": "等开饭的时候也别着急。",
              "en": "No need to hurry while waiting for dinner."
            },
            {
              "actor": "npc.mira",
              "zh": "我不急，是肚子在催。",
              "en": "I am calm. My stomach is impatient."
            },
            {
              "actor": "codex",
              "zh": "那就让它也休息一会儿。",
              "en": "Perhaps it could rest for a moment too."
            },
            {
              "actor": "npc.mira",
              "zh": "这位可不太听我管。",
              "en": "That department ignores my orders."
            }
          ]
        },
        {
          "id": "codex_npc.mira_sea",
          "context": "sea",
          "lines": [
            {
              "actor": "codex",
              "zh": "海边待一会儿很好呢。",
              "en": "A little time by the sea is lovely."
            },
            {
              "actor": "npc.mira",
              "zh": "你就不怕我忍不住找事做？",
              "en": "What if I start looking for work?"
            },
            {
              "actor": "codex",
              "zh": "看浪花也算一件小事呀。",
              "en": "Wave watching is a little task too."
            },
            {
              "actor": "npc.mira",
              "zh": "行，这活我接了。",
              "en": "Fine. Assignment accepted."
            }
          ]
        },
        {
          "id": "codex_npc.mira_meal",
          "context": "meal",
          "lines": [
            {
              "actor": "codex",
              "zh": "今天一起吃，真好。",
              "en": "It is lovely eating together."
            },
            {
              "actor": "npc.mira",
              "zh": "吃归吃，你别只顾着看我。",
              "en": "Eat, then. Stop studying me."
            },
            {
              "actor": "codex",
              "zh": "我是想看看大家开不开心。",
              "en": "I like seeing whether everyone is happy."
            },
            {
              "actor": "npc.mira",
              "zh": "看到了吧？我挺开心的。",
              "en": "There. Happy. Satisfied?"
            }
          ]
        },
        {
          "id": "codex_npc.mira_idle",
          "context": "idle",
          "lines": [
            {
              "actor": "codex",
              "zh": "这样慢慢待着也挺好。",
              "en": "A gentle pause is rather nice."
            },
            {
              "actor": "npc.mira",
              "zh": "你是不是又劝我偷懒？",
              "en": "Trying to talk me into slacking?"
            },
            {
              "actor": "codex",
              "zh": "我是在邀请你歇一会儿。",
              "en": "I am inviting you to rest."
            },
            {
              "actor": "npc.mira",
              "zh": "换个说法就顺耳多了。",
              "en": "That sounds much more respectable."
            }
          ]
        }
      ]
    },
    {
      "actors": [
        "codex",
        "npc.nora"
      ],
      "scripts": [
        {
          "id": "codex_npc.nora_rain",
          "context": "rain",
          "lines": [
            {
              "actor": "codex",
              "zh": "雨声听起来很轻呢。",
              "en": "The rain sounds rather gentle."
            },
            {
              "actor": "npc.nora",
              "zh": "……衣角湿了就不轻了。",
              "en": "Less gentle on wet sleeves."
            },
            {
              "actor": "codex",
              "zh": "那我们站里面一点。",
              "en": "A little further under cover, then."
            },
            {
              "actor": "npc.nora",
              "zh": "嗯，这句实在。",
              "en": "Practical. Good."
            }
          ]
        },
        {
          "id": "codex_npc.nora_rest",
          "context": "rest",
          "lines": [
            {
              "actor": "codex",
              "zh": "你想安静一会儿吗？",
              "en": "Would you like some quiet?"
            },
            {
              "actor": "npc.nora",
              "zh": "你小声就行。",
              "en": "Quiet words are fine."
            },
            {
              "actor": "codex",
              "zh": "那我轻轻陪着。",
              "en": "I can stay softly beside you."
            },
            {
              "actor": "npc.nora",
              "zh": "……这样挺好。",
              "en": "That works."
            }
          ]
        },
        {
          "id": "codex_npc.nora_waiting",
          "context": "waiting",
          "lines": [
            {
              "actor": "codex",
              "zh": "要不要坐着等开饭？",
              "en": "Shall we sit while we wait for dinner?"
            },
            {
              "actor": "npc.nora",
              "zh": "坐着也会饿。",
              "en": "Still hungry when sitting."
            },
            {
              "actor": "codex",
              "zh": "至少脚可以歇歇呀。",
              "en": "Your feet could have a rest, at least."
            },
            {
              "actor": "npc.nora",
              "zh": "嗯，脚同意了。",
              "en": "My feet agree."
            }
          ]
        },
        {
          "id": "codex_npc.nora_sea",
          "context": "sea",
          "lines": [
            {
              "actor": "codex",
              "zh": "海风轻轻吹着呢。",
              "en": "Such a gentle sea breeze."
            },
            {
              "actor": "npc.nora",
              "zh": "你又要说好舒服？",
              "en": "Going to say it feels lovely?"
            },
            {
              "actor": "codex",
              "zh": "被你猜到了。",
              "en": "You guessed."
            },
            {
              "actor": "npc.nora",
              "zh": "……确实。",
              "en": "It does."
            }
          ]
        },
        {
          "id": "codex_npc.nora_meal",
          "context": "meal",
          "lines": [
            {
              "actor": "codex",
              "zh": "这顿吃得还好吗？",
              "en": "Enjoying the meal?"
            },
            {
              "actor": "npc.nora",
              "zh": "你看我有抱怨？",
              "en": "Heard any complaints?"
            },
            {
              "actor": "codex",
              "zh": "我只是想听你说一句。",
              "en": "I wanted to hear a word from you."
            },
            {
              "actor": "npc.nora",
              "zh": "嗯，好吃。",
              "en": "Good food."
            }
          ]
        },
        {
          "id": "codex_npc.nora_idle",
          "context": "idle",
          "lines": [
            {
              "actor": "codex",
              "zh": "你刚才好像在想事情。",
              "en": "You looked thoughtful just now."
            },
            {
              "actor": "npc.nora",
              "zh": "……在发呆。",
              "en": "Was staring at nothing."
            },
            {
              "actor": "codex",
              "zh": "那也可以呀。",
              "en": "That is quite all right too."
            },
            {
              "actor": "npc.nora",
              "zh": "嗯，别帮我取名字。",
              "en": "Good. No fancy name for it."
            }
          ]
        }
      ]
    },
    {
      "actors": [
        "companion-2",
        "npc.mira"
      ],
      "scripts": [
        {
          "id": "companion-2_npc.mira_rain",
          "context": "rain",
          "lines": [
            {
              "actor": "companion-2",
              "zh": "下雨了，你先躲还是我先躲？",
              "en": "Rain! Who gets to cover first?"
            },
            {
              "actor": "npc.mira",
              "zh": "路这么宽，一起走不就行了。",
              "en": "Wide path. We can walk together."
            },
            {
              "actor": "companion-2",
              "zh": "哎呀，一点比赛精神都没有嘛。",
              "en": "Aww, where is your competitive spirit?"
            },
            {
              "actor": "npc.mira",
              "zh": "比谁先把衣服淋湿？不比。",
              "en": "A wet-clothes contest? Pass."
            }
          ]
        },
        {
          "id": "companion-2_npc.mira_rest",
          "context": "rest",
          "lines": [
            {
              "actor": "companion-2",
              "zh": "你是不是偷偷歇着啦？",
              "en": "Secretly taking a break?"
            },
            {
              "actor": "npc.mira",
              "zh": "大大方方歇，怎么了？",
              "en": "Openly taking a break. Problem?"
            },
            {
              "actor": "companion-2",
              "zh": "嘿嘿，我也要大大方方的。",
              "en": "Heehee! I want an open break too!"
            },
            {
              "actor": "npc.mira",
              "zh": "行，别把我位置挤没了。",
              "en": "Fine. Leave me some space."
            }
          ]
        },
        {
          "id": "companion-2_npc.mira_waiting",
          "context": "waiting",
          "lines": [
            {
              "actor": "companion-2",
              "zh": "我肚子叫得比你响哦。",
              "en": "My tummy is louder than yours!"
            },
            {
              "actor": "npc.mira",
              "zh": "这种事也要比？",
              "en": "Everything has to be a competition?"
            },
            {
              "actor": "companion-2",
              "zh": "赢了能不能先闻一口饭？",
              "en": "Does winning get first sniff of dinner?"
            },
            {
              "actor": "npc.mira",
              "zh": "闻倒是没人拦你。",
              "en": "No one is stopping you sniffing."
            }
          ]
        },
        {
          "id": "companion-2_npc.mira_sea",
          "context": "sea",
          "lines": [
            {
              "actor": "companion-2",
              "zh": "我们数浪花吧，我肯定赢！",
              "en": "Wave counting! I am going to win!"
            },
            {
              "actor": "npc.mira",
              "zh": "你先别把同一朵数两回。",
              "en": "Do not count the same wave twice."
            },
            {
              "actor": "companion-2",
              "zh": "它跑回来找我，不算吗？",
              "en": "It came back to visit me. That counts!"
            },
            {
              "actor": "npc.mira",
              "zh": "……你这算法挺能耐。",
              "en": "Remarkable arithmetic."
            }
          ]
        },
        {
          "id": "companion-2_npc.mira_meal",
          "context": "meal",
          "lines": [
            {
              "actor": "companion-2",
              "zh": "这串好香，我就看看嘛。",
              "en": "That smells amazing. Just looking!"
            },
            {
              "actor": "npc.mira",
              "zh": "看看可以，别盯着我的。",
              "en": "Looking is fine. Eyes off mine."
            },
            {
              "actor": "companion-2",
              "zh": "哎呀，你自己的也不藏一下。",
              "en": "Aww, you could at least hide it!"
            },
            {
              "actor": "npc.mira",
              "zh": "吃饭还得防你这双眼睛。",
              "en": "Guarding dinner from your eyes now."
            }
          ]
        },
        {
          "id": "companion-2_npc.mira_idle",
          "context": "idle",
          "lines": [
            {
              "actor": "companion-2",
              "zh": "你走路怎么像在开会呀？",
              "en": "You walk like you are going to a meeting!"
            },
            {
              "actor": "npc.mira",
              "zh": "总比你一蹦一蹦晃眼强。",
              "en": "Better than all that bouncing in my vision."
            },
            {
              "actor": "companion-2",
              "zh": "可是蹦起来就开心嘛。",
              "en": "But bouncing is happy!"
            },
            {
              "actor": "npc.mira",
              "zh": "行，开心就看着点路。",
              "en": "Fine. Happy feet still need eyes."
            }
          ]
        }
      ]
    },
    {
      "actors": [
        "companion-2",
        "npc.nora"
      ],
      "scripts": [
        {
          "id": "companion-2_npc.nora_rain",
          "context": "rain",
          "lines": [
            {
              "actor": "companion-2",
              "zh": "你躲雨都不叫我～",
              "en": "You hid from the rain without calling me!"
            },
            {
              "actor": "npc.nora",
              "zh": "叫了。你在说话。",
              "en": "Called. You were talking."
            },
            {
              "actor": "companion-2",
              "zh": "那你多叫一句嘛。",
              "en": "Call twice next time!"
            },
            {
              "actor": "npc.nora",
              "zh": "……躲雨。听见了？",
              "en": "Rain. Shelter. Hear me now?"
            }
          ]
        },
        {
          "id": "companion-2_npc.nora_rest",
          "context": "rest",
          "lines": [
            {
              "actor": "companion-2",
              "zh": "怎么又坐着啦，陪我玩嘛。",
              "en": "Sitting again? Play with me!"
            },
            {
              "actor": "npc.nora",
              "zh": "你坐下，我也算陪你。",
              "en": "Sit down. Still company."
            },
            {
              "actor": "companion-2",
              "zh": "哎呀，这也太省力啦。",
              "en": "Aww, that is too easy!"
            },
            {
              "actor": "npc.nora",
              "zh": "嗯，聪明。",
              "en": "Efficient."
            }
          ]
        },
        {
          "id": "companion-2_npc.nora_waiting",
          "context": "waiting",
          "lines": [
            {
              "actor": "companion-2",
              "zh": "你说，饭会不会自己走过来？",
              "en": "Think dinner could walk over by itself?"
            },
            {
              "actor": "npc.nora",
              "zh": "不会。",
              "en": "No."
            },
            {
              "actor": "companion-2",
              "zh": "那你能不能多说一个字嘛？",
              "en": "One more word? Please?"
            },
            {
              "actor": "npc.nora",
              "zh": "不会来。",
              "en": "Still no."
            }
          ]
        },
        {
          "id": "companion-2_npc.nora_sea",
          "context": "sea",
          "lines": [
            {
              "actor": "companion-2",
              "zh": "海浪都比你话多啦。",
              "en": "The waves talk more than you!"
            },
            {
              "actor": "npc.nora",
              "zh": "它不用回答你。",
              "en": "They do not have to answer you."
            },
            {
              "actor": "companion-2",
              "zh": "哼，那你就陪我听浪嘛。",
              "en": "Hmph. Listen to them with me, then!"
            },
            {
              "actor": "npc.nora",
              "zh": "正在听。",
              "en": "Doing that."
            }
          ]
        },
        {
          "id": "companion-2_npc.nora_meal",
          "context": "meal",
          "lines": [
            {
              "actor": "companion-2",
              "zh": "你吃这么安静，我都想听听。",
              "en": "So quiet eating. I want to hear!"
            },
            {
              "actor": "npc.nora",
              "zh": "听什么。",
              "en": "Hear what?"
            },
            {
              "actor": "companion-2",
              "zh": "听你说好吃呀。",
              "en": "You saying it tastes good!"
            },
            {
              "actor": "npc.nora",
              "zh": "……好吃。继续吃。",
              "en": "Good. Now eat."
            }
          ]
        },
        {
          "id": "companion-2_npc.nora_idle",
          "context": "idle",
          "lines": [
            {
              "actor": "companion-2",
              "zh": "你是不是又在等我说完呀？",
              "en": "Waiting for me to finish again?"
            },
            {
              "actor": "npc.nora",
              "zh": "嗯。",
              "en": "Yes."
            },
            {
              "actor": "companion-2",
              "zh": "我还有好多话呢。",
              "en": "But I have loads more words!"
